{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "description": "The only predicate language used throughout waits and classification.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "element_present",
        "element_absent",
        "text_matches",
        "url_matches"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "description": "Portable semantic intent; never a generated Playwright selector.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "frame_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Name"
        },
        "frame_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Title"
        },
        "near_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Label"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "structural_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Fallback"
        },
        "structural_surface": {
          "anyOf": [
            {
              "const": "playwright",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Surface"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "within": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Target",
      "type": "object"
    },
    "TargetScope": {
      "additionalProperties": false,
      "description": "A semantic container used to disambiguate repeated controls.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "TargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "detection_condition": {
      "$ref": "#/$defs/Condition"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "detection_condition"
  ],
  "title": "BusinessOutcome",
  "type": "object"
}
