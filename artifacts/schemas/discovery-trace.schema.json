{
  "$defs": {
    "ActionType": {
      "enum": [
        "navigate",
        "click",
        "type",
        "read",
        "wait_for"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "The only predicate language used throughout waits and classification.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "element_present",
        "element_absent",
        "text_matches",
        "url_matches"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "DiscoveryAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "evidence_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_postcondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incidental": {
          "default": false,
          "title": "Incidental",
          "type": "boolean"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "observed_result": {
          "title": "Observed Result"
        },
        "rationale": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "read_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Value"
        },
        "reads_into": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reads Into"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel",
          "default": "safe"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "index",
        "action",
        "rationale",
        "observed_result"
      ],
      "title": "DiscoveryAction",
      "type": "object"
    },
    "DiscoveryStatus": {
      "enum": [
        "success",
        "escalated",
        "hard_failure"
      ],
      "title": "DiscoveryStatus",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kind": {
          "default": "file",
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "GoalSpec": {
      "additionalProperties": false,
      "properties": {
        "input_specs": {
          "items": {
            "$ref": "#/$defs/InputSpec"
          },
          "title": "Input Specs",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "maximum_steps": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Maximum Steps",
          "type": "integer"
        },
        "natural_language_goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Natural Language Goal",
          "type": "string"
        },
        "requested_outputs": {
          "items": {
            "$ref": "#/$defs/OutputSpec"
          },
          "title": "Requested Outputs",
          "type": "array"
        },
        "target_entry_point": {
          "minLength": 1,
          "title": "Target Entry Point",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "natural_language_goal",
        "target_entry_point",
        "input_specs",
        "inputs",
        "requested_outputs"
      ],
      "title": "GoalSpec",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        },
        "validation_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Pattern"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "parser": {
          "anyOf": [
            {
              "enum": [
                "text",
                "integer",
                "number",
                "decimal",
                "currency_decimal",
                "boolean"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "source"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "safe",
        "requires_confirmation",
        "irreversible"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "description": "Portable semantic intent; never a generated Playwright selector.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "frame_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Name"
        },
        "frame_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Title"
        },
        "near_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Label"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "structural_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Fallback"
        },
        "structural_surface": {
          "anyOf": [
            {
              "const": "playwright",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Surface"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "Target",
      "type": "object"
    },
    "ValueType": {
      "enum": [
        "string",
        "integer",
        "number",
        "decimal",
        "boolean"
      ],
      "title": "ValueType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/DiscoveryAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "declared_outputs": {
      "additionalProperties": true,
      "title": "Declared Outputs",
      "type": "object"
    },
    "evidence_references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "final_status": {
      "$ref": "#/$defs/DiscoveryStatus"
    },
    "goal": {
      "$ref": "#/$defs/GoalSpec"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "success_condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "goal",
    "provider",
    "model",
    "started_at",
    "completed_at",
    "actions",
    "final_status",
    "declared_outputs"
  ],
  "title": "DiscoveryTrace",
  "type": "object"
}
