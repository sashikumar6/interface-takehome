{
  "$defs": {
    "ActionType": {
      "enum": [
        "navigate",
        "click",
        "type",
        "read",
        "wait_for"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "The only predicate language used throughout waits and classification.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "element_present",
        "element_absent",
        "text_matches",
        "url_matches"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "backoff_seconds": {
          "default": 0,
          "maximum": 30,
          "minimum": 0,
          "title": "Backoff Seconds",
          "type": "number"
        },
        "maximum_attempts": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Maximum Attempts",
          "type": "integer"
        },
        "retryable_error_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Retryable Error Codes",
          "type": "array"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "safe",
        "requires_confirmation",
        "irreversible"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "description": "Portable semantic intent; never a generated Playwright selector.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "frame_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Name"
        },
        "frame_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Title"
        },
        "near_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Label"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "structural_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Fallback"
        },
        "structural_surface": {
          "anyOf": [
            {
              "const": "playwright",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Surface"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "within": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Target",
      "type": "object"
    },
    "TargetScope": {
      "additionalProperties": false,
      "description": "A semantic container used to disambiguate repeated controls.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "TargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ActionType"
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "outcome_probe_timeout_ms": {
      "default": 100,
      "maximum": 5000,
      "minimum": 50,
      "title": "Outcome Probe Timeout Ms",
      "type": "integer"
    },
    "precondition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reads_into": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reads Into"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "safe"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeout_ms": {
      "default": 5000,
      "maximum": 120000,
      "minimum": 100,
      "title": "Timeout Ms",
      "type": "integer"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "id",
    "action"
  ],
  "title": "Step",
  "type": "object"
}
