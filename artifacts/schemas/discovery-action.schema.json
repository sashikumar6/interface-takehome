{
  "$defs": {
    "ActionType": {
      "enum": [
        "navigate",
        "click",
        "type",
        "read",
        "wait_for"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "The only predicate language used throughout waits and classification.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "element_present",
        "element_absent",
        "text_matches",
        "url_matches"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kind": {
          "default": "file",
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "safe",
        "requires_confirmation",
        "irreversible"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "description": "Portable semantic intent; never a generated Playwright selector.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "frame_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Name"
        },
        "frame_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Title"
        },
        "near_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Label"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "structural_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Fallback"
        },
        "structural_surface": {
          "anyOf": [
            {
              "const": "playwright",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Surface"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ActionType"
    },
    "evidence_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_postcondition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "incidental": {
      "default": false,
      "title": "Incidental",
      "type": "boolean"
    },
    "index": {
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "observed_result": {
      "title": "Observed Result"
    },
    "rationale": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "read_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Read Value"
    },
    "reads_into": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reads Into"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "safe"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "index",
    "action",
    "rationale",
    "observed_result"
  ],
  "title": "DiscoveryAction",
  "type": "object"
}
