{
  "$defs": {
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        },
        "validation_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Pattern"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "parser": {
          "anyOf": [
            {
              "enum": [
                "text",
                "integer",
                "number",
                "decimal",
                "currency_decimal",
                "boolean"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "source"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "ValueType": {
      "enum": [
        "string",
        "integer",
        "number",
        "decimal",
        "boolean"
      ],
      "title": "ValueType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "input_specs": {
      "items": {
        "$ref": "#/$defs/InputSpec"
      },
      "title": "Input Specs",
      "type": "array"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "maximum_steps": {
      "default": 20,
      "maximum": 100,
      "minimum": 1,
      "title": "Maximum Steps",
      "type": "integer"
    },
    "natural_language_goal": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Natural Language Goal",
      "type": "string"
    },
    "requested_outputs": {
      "items": {
        "$ref": "#/$defs/OutputSpec"
      },
      "title": "Requested Outputs",
      "type": "array"
    },
    "target_entry_point": {
      "minLength": 1,
      "title": "Target Entry Point",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 120,
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "natural_language_goal",
    "target_entry_point",
    "input_specs",
    "inputs",
    "requested_outputs"
  ],
  "title": "GoalSpec",
  "type": "object"
}
