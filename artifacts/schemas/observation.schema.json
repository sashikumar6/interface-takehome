{
  "$defs": {
    "ActionableElement": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "ActionableElement",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kind": {
          "default": "file",
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alerts",
      "type": "array"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "elements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActionableElement"
      },
      "title": "Elements",
      "type": "array"
    },
    "screenshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "visible_text": {
      "maxLength": 8000,
      "title": "Visible Text",
      "type": "string"
    }
  },
  "required": [
    "url",
    "title",
    "visible_text",
    "digest"
  ],
  "title": "Observation",
  "type": "object"
}
