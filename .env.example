# Exactly one provider key is required only for genuine LLM discovery.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provider/model choices. Secrets are never written to evidence.
COMPUTER_USE_PROVIDER=openai
COMPUTER_USE_MODEL=gpt-4.1-mini
COMPUTER_USE_ANTHROPIC_MODEL=claude-sonnet-4-5

# Local-only demo configuration and shared execution limits.
COMPUTER_USE_DEMO_ORIGIN=http://127.0.0.1:8765
COMPUTER_USE_EVIDENCE_DIR=evidence
COMPUTER_USE_MAX_STEPS=20
COMPUTER_USE_RUN_TIMEOUT_SECONDS=120
